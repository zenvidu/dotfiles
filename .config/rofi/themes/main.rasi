
@import	"~/.config/matugen/generated/rofi-matugen.rasi"

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       700px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    //border:                      0px solid;
    border:                      2px 2px 0px 0px;
    border-radius:               20px 5px 20px 5px;
    border-color:                @primary;
    cursor:                      "default";
    background-color:            @surface-alpha;
}

mainbox {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    //border-color:                @primary;
    background-color:            transparent;
    children:                    [ "inputbar", "listbox" ];
}

listbox {
    spacing:                     20px;
    padding:                     20px;
    orientation:                 vertical;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

inputbar {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     10px;
    margin:                      0px;
    padding:                     20px 30px;
    border:                      0px;
    border-radius:               0px;
    //border-color:                @primary;
    background-color:            transparent;
    background-image:            url("~/.cache/wallvas/cwall", width);
    text-color:                  @on-surface;
    children:                    [ "textbox-prompt-colon", "entry", "dummy", "mode-switcher"];
}

message {
    enabled:                     false;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               20px 5px 20px 5px;
    //border-color:                @primary;
    background-color:            transparent;
    text-color:                  transparent;
}

textbox {
    padding:                     12px;
    border-radius:               7px;
    background-color:            @surface-alpha;
    text-color:                  @on-surface;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    //placeholder-color:           @foreground;
    blink:                       true;
    markup:                      true;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    padding:                     12px 15px;
    background-color:            transparent;
    text-color:                  @primary;
}

entry {
    enabled:                     true;
    font:                        @primary-font;
    expand:                      false;
    width:                       250px;
    padding:                     12px 16px;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    cursor-color:                transparent;
    placeholder:                 "Search";
    placeholder-color:           @on-surface-variant-alpha;
}

dummy {
    expand:                      true;
    background-color:            transparent;
}

mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    background-color:            transparent;
}

button {
    width:                       45px;
    padding:                     12px;
    background-color:            transparent;
    text-color:                  @tertiary-dim;
    cursor:                      pointer;
}

button selected {
    text-color:                  @primary;
}

listview {
    enabled:                     true;
    columns:                     2;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    //border-color:                @primary;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      "default";
}

element {
    spacing:                     10px;
    padding:                     5px;
    border:                      0px solid;
    border-radius:               20px 5px 20px 5px;
    border-color:                @primary;
    background-color:            transparent;
}

element-text {
    font:                        @primary-font;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element selected normal, element selected active {
    border:                      0px;
    background-color:            @on-primary-alpha;
    text-color:                  @on-surface;
}

element-text selected normal, element-text selected active {
    text-color:                  @on-surface;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        30px;
    cursor:                      pointer;
}

error-message {
    padding:                     0px;
    border:                      0px solid;
    border-radius:               20px 5px 20px 5px;
    background-color:            @on-primary-alpha;
    text-color:                  @tertiary;
}
