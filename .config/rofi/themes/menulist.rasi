
@import	"~/.config/matugen/generated/rofi-matugen.rasi"


window {
    transparency:                "real";
    location:                    north;
    anchor:                      north;
    fullscreen:                  false;
    width:                       530px;
    x-offset:                    0px;
    y-offset:                    30px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @primary;
    cursor:                      "default";
    background-color:            transparent;
}

mainbox {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    //border-color:                @primary;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    //border-color:                @primary;
    background-color:            transparent;
    text-color:                  @on-surface;
    children:                    [ "prompt"];
}

prompt {
    enabled:                     true;
    padding:                     12px;
    border-radius:               0px;
    //background-color:            @active;
    //text-color:                  @background;
}

message {
    enabled:                     true;
    margin:                      0px;
    padding:                     15px;
    border:                      0px solid;
    border-radius:               20px 5px 20px 5px;
    //border-color:                @primary;
    background-color:            @surface-alpha;
    text-color:                  @primary;
}
textbox {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    //placeholder-color:           @foreground;
    blink:                       true;
    markup:                      true;
}

listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     15px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    //border-color:                @primary;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      "default";
}

element {
    padding:                     25px 10px;
    border:                      0px solid;
    border-radius:               20px 5px 20px 5px;
    border-color:                @primary;
    background-color:            @surface-alpha;
}

element-text {
    font:                        @icon-font;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

element selected normal, element selected active {
    border:                      0px 0px 2px 2px;
    background-color:            @surface-alpha;
    text-color:                  @primary;
}

element-text selected normal, element-text selected active {
    text-color:                  @tertiary;
}

error-message {
    padding:                     0px;
    border:                      0px solid;
    border-radius:               20px 5px 20px 5px;
    //border-color:                @primary;
    background-color:            @on-primary-alpha;
    text-color:                  @tertiary;
}
